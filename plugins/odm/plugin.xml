<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="com.adjust.sdk.odm"
    version="5.8.2">

    <name>AdjustGoogleOdm</name>
    <description>Google On-Device Measurement (ODM) support for the Adjust Cordova plugin</description>
    <license>MIT License</license>
    <keywords>adjust,odm</keywords>
    <author>adjust</author>

    <engines>
        <engine name="cordova-ios" version=">=3.0.0" />
        <!-- SPM resolution (plugin.xml package="swift") requires cordova-ios >=8.0.0; older
             versions ignore the package attribute and fall back to the CocoaPods podspec below. -->
    </engines>

    <!-- iOS -->
    <platform name="ios" package="swift">
        <source-file src="src/ios/AdjustCordovaOdm.m" />
        <podspec>
            <config>
                <source url="https://cdn.cocoapods.org/"/>
            </config>
            <pods use-frameworks="true">
                <pod name="Adjust/AdjustGoogleOdm" spec="5.8.2" nospm="true" />
                <!-- the Adjust/AdjustGoogleOdm subspec doesn't pull in Google's SDK; keep within the
                     range Adjust supports (2.0.0 up to, not including, 4.0.0) -->
                <pod name="GoogleAdsOnDeviceConversion" spec="~> 3.0" nospm="true" />
            </pods>
        </podspec>
    </platform>
</plugin>
