# macOS
.DS_Store

# editors and merge leftovers
.idea/
.vscode/
*.iml
*.swp
*.orig

# python bytecode left behind by the scripts
__pycache__/
*.pyc

# npm: the scripts install every app from scratch, so modules and lockfiles stay local
node_modules/
package-lock.json

# Cordova apps: platforms and plugins are added again on every run
/example-cordova/platforms/
/example-cordova/plugins/
/test/app/cordova/platforms/
/test/app/cordova/plugins/

# Ionic apps: the web build and the native projects are generated again on every run
/example-ionic-capacitor/.angular/
/example-ionic-capacitor/www/
/example-ionic-capacitor/android/
/example-ionic-capacitor/ios/
/test/app/ionic/.angular/
/test/app/ionic/www/
/test/app/ionic/android/
/test/app/ionic/ios/
